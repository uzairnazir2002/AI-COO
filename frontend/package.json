{
  "name": "ai-coo-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "e2e": "playwright test",
    "e2e:full": "playwright test",
    "e2e:smoke": "playwright test e2e/responsive-mobile.spec.ts e2e/responsive-smoke.spec.ts e2e/onboarding-workspace.spec.ts e2e/auth-confirm-ui.spec.ts e2e/rbac-viewer-api.spec.ts e2e/rbac-viewer-settings-api.spec.ts e2e/stripe-reconciliation-invalid-range.spec.ts",
    "e2e:smoke:ci": "cross-env E2E_USE_EXTERNAL_BASE_URL=1 E2E_BASE_URL=http://localhost:3000 E2E_API_URL=http://localhost:8000/api/v1 E2E_AUTH_MODE=bearer npm run e2e:smoke",
    "e2e:sse": "cross-env E2E_SSE=1 playwright test e2e/sse-fallback.spec.ts",
    "e2e:integrations": "playwright test e2e/plaid-integration.spec.ts e2e/stripe-integration.spec.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:cookie": "cross-env E2E_AUTH_MODE=cookie playwright test",
    "e2e:visual": "cross-env E2E_VISUAL=1 playwright test e2e/visual.spec.ts",
    "e2e:visual:update": "cross-env E2E_VISUAL=1 playwright test e2e/visual.spec.ts --update-snapshots",
    "format": "prettier --write .",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.12",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "20.16.5",
    "@types/react": "18.3.5",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "9.11.1",
    "eslint-config-next": "15.5.12",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.2"
  }
}
