# Core
ENV_FILE=.env
POSTGRES_DB=ai_coo
POSTGRES_USER=ai_coo
POSTGRES_PASSWORD=ai_coo
DATABASE_URL=postgresql+asyncpg://ai_coo:ai_coo@postgres:5432/ai_coo
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reports
MINIO_SECURE=false

# Backend
APP_NAME=AI COO
ENV=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Increase locally (e.g. 120) if disposable-user Playwright runs hit 429 during rapid register/login.
RATE_LIMIT_PER_MINUTE=20
IDEMPOTENCY_TTL_HOURS=72
AUTH_LOCKOUT_THRESHOLD=6
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=30
PII_ENCRYPTION_KEYS=
PII_ENCRYPTION_ACTIVE_KEY_ID=primary
DELETION_GRACE_PERIOD_DAYS=14
CSV_MAX_BYTES=5242880
ANALYTICS_SUMMARY_CACHE_TTL_SECONDS=5
ALERTS_CACHE_TTL_SECONDS=5
TRANSACTIONS_CACHE_TTL_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
API_DB_POOL_SIZE=12
API_DB_MAX_OVERFLOW=4
API_DB_POOL_TIMEOUT_SECONDS=30
API_DB_POOL_RECYCLE_SECONDS=1800
WORKER_DB_POOL_SIZE=4
WORKER_DB_MAX_OVERFLOW=0
WORKER_DB_POOL_TIMEOUT_SECONDS=30
WORKER_DB_POOL_RECYCLE_SECONDS=1800
WORKER_CONCURRENCY=3
WORKER_PREFETCH_MULTIPLIER=1
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
EMAIL_DRY_RUN=true
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=AI-COO
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
AUTH_CONFIRMATION_TOKEN_TTL_MINUTES=30
AUTH_CONFIRMATION_CODE_TTL_MINUTES=15
AUTH_CONFIRMATION_MAX_ATTEMPTS=5
AI_PROVIDER=stub
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OLLAMA_SERVER_URL=http://localhost:5000/ai
AI_OLLAMA_SERVER_API_KEY=
AI_OLLAMA_SERVER_MODEL=
AI_TIMEOUT_SECONDS=20
# Playwright `e2e:smoke` with E2E_AUTH_MODE=bearer expects false (JSON tokens on login). Cookie/CSRF E2E needs true + NEXT_PUBLIC_AUTH_MODE=cookie.
AUTH_COOKIE_MODE=false
ENFORCE_HTTPS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=ai_coo_access_token
REFRESH_COOKIE_NAME=ai_coo_refresh_token
CSRF_COOKIE_NAME=ai_coo_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
EXPOSE_INVITE_TOKEN_IN_RESPONSE=true
MFA_TOTP_ISSUER=AI COO
RUNTIME_SLO_WINDOW_SECONDS=300
RUNTIME_SLO_P95_MS=2000
RUNTIME_SLO_ERROR_RATE_PCT=1
RUNTIME_SLO_TOP_N=20
RUNTIME_QUEUE_LAG_THRESHOLD_SECONDS=180
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_PROVIDER=stub
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
PLAID_WEBHOOK_SECRET=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_AUTH_MODE=bearer
NEXT_PUBLIC_CSRF_COOKIE_NAME=ai_coo_csrf_token
NEXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token
NEXT_PUBLIC_CSV_MAX_BYTES=5242880
NEXT_PUBLIC_MINIO_PUBLIC_BASE_URL=http://localhost:9000
NEXT_PUBLIC_SSE_RECONNECT_DELAY_MS=5000
NEXT_PUBLIC_SSE_FAILURE_THRESHOLD=3
NEXT_PUBLIC_SSE_FALLBACK_POLL_INTERVAL_MS=15000
NEXT_PUBLIC_BUDGET_ALERT_THRESHOLD_PCT=10
NEXT_PUBLIC_PLAID_LINK_SCRIPT_URL=https://cdn.plaid.com/link/v2/stable/link-initialize.js

# Smoke scripts (scripts/smoke_*.py)
# Set these to reuse an existing confirmed user/org instead of creating a disposable one.
SMOKE_BASE_URL=http://127.0.0.1:8000/api/v1
SMOKE_AUTH_MODE=bearer
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=
SMOKE_ORG_ID=
SMOKE_AS_OF=
