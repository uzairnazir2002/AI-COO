# Core
ENV_FILE=.env
POSTGRES_DB=ai_coo
POSTGRES_USER=ai_coo
POSTGRES_PASSWORD=ai_coo
DATABASE_URL=postgresql+asyncpg://ai_coo:ai_coo@postgres:5432/ai_coo
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reports
MINIO_SECURE=false

# Backend
APP_NAME=AI COO
ENV=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_PER_MINUTE=20
CSV_MAX_BYTES=5242880
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DRY_RUN=true
AI_PROVIDER=stub
AUTH_COOKIE_MODE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=ai_coo_access_token
REFRESH_COOKIE_NAME=ai_coo_refresh_token
CSRF_COOKIE_NAME=ai_coo_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
EXPOSE_INVITE_TOKEN_IN_RESPONSE=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_AUTH_MODE=bearer
NEXT_PUBLIC_CSRF_COOKIE_NAME=ai_coo_csrf_token
NEXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token
NEXT_PUBLIC_CSV_MAX_BYTES=5242880
NEXT_PUBLIC_MINIO_PUBLIC_BASE_URL=http://localhost:9000
